DISCORD_TOKEN=coloque_o_token_do_bot_aqui
# Banco do NAT-CORE (opcional; padrão data/natty.db, relativo à raiz do projeto)
NATTY_DB_PATH=data/natty.db
# Servidor da Crossroads, pra sincronizar os membros (cog do core e
# scripts/sincronizar_membros.py). Opcional se o bot só está em um servidor.
GUILD_ID=
# Planilha antiga: só usada por scripts/migrar_sheets_para_sqlite.py
GOOGLE_SHEET_NAME=NAT-CORE
GOOGLE_CREDENTIALS_FILE=credentials.json
# Bardo: pasta de músicas locais (opcional; padrão data/musicas, fora do git)
BARDO_PASTA_LOCAL=data/musicas
# Bardo: banco próprio (playlists, sons, cenas, descobertas; padrão data/bardo.db, fora do git)
BARDO_DB_PATH=data/bardo.db
# Bardo: cargo que controla o painel e apaga coisa salva (padrão Condutor)
BARDO_CARGO_MESTRE=Condutor
# Painel web (opcional): só liga com o client secret do app (Developer Portal >
# OAuth2). Cadastre lá o redirect <NATTY_PAINEL_URL>/auth/callback.
DISCORD_CLIENT_SECRET=
NATTY_PAINEL_PORT=8710
NATTY_PAINEL_URL=http://localhost:8710
